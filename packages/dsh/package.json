{
  "name": "@fukangz/dsh-bilibili-subtitles",
  "version": "0.1.3",
  "description": "DeepSeek Harness（dsh）插件：把 B 站长视频整理成忠实原话、带原片跳转链接的 Markdown 全文，基于已有中文字幕切分章节、修顺零散台词",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FukangZ/bilibili-subtitles.git",
    "directory": "packages/dsh"
  },
  "homepage": "https://github.com/FukangZ/bilibili-subtitles/tree/HEAD/packages/dsh#readme",
  "bugs": {
    "url": "https://github.com/FukangZ/bilibili-subtitles/issues"
  },
  "keywords": ["dsh-plugin", "deepseek", "bilibili", "subtitles", "transcript", "markdown", "llm"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["dist/", "client.js", "cordis.patch.yml", "locale/", "icon.svg", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.ts"
  },
  "engines": { "node": ">=22", "dsh": ">=0.2.2-rc.1 <0.3.0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "dependencies": {
    "@fukangz/core-bilibili-subtitles": "^0.1.3"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "devDependencies": { "@types/node": "^22.15.30" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" }
}
