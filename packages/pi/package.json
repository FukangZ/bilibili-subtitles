{
  "name": "@fukangz/pi-bilibili-subtitles",
  "version": "0.1.4",
  "description": "Pi 扩展：把 B 站长视频整理成忠实原话、带原片跳转链接的 Markdown 全文，基于已有中文字幕切分章节、修顺零散台词",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FukangZ/bilibili-subtitles.git",
    "directory": "packages/pi"
  },
  "homepage": "https://github.com/FukangZ/bilibili-subtitles/tree/HEAD/packages/pi#readme",
  "bugs": {
    "url": "https://github.com/FukangZ/bilibili-subtitles/issues"
  },
  "keywords": [
    "pi-package",
    "bilibili",
    "subtitles",
    "transcript",
    "markdown",
    "llm"
  ],
  "files": [
    "src/",
    "README.md",
    "bilibili-subtitles.example.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://cdn.jsdelivr.net/gh/FukangZ/bilibili-subtitles@main/assets/readme/hero.svg"
  },
  "scripts": {
    "link-peers": "node scripts/link-peers.mjs",
    "check": "node scripts/link-peers.mjs && tsc --noEmit",
    "test": "node scripts/link-peers.mjs && node --experimental-strip-types --test --test-concurrency=1 tests/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5"
  },
  "dependencies": {
    "@fukangz/core-bilibili-subtitles": "^0.1.4"
  }
}
